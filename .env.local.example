# ══════════════════════════════════════════════════════════════════════════════
# BeeLuxe Cleaners — Environment Variables
# Copy this file to .env.local for local development.
# NEVER commit .env.local — it is in .gitignore.
#
# TIER GUIDE:
#   .env.local            → development (this file)
#   Vercel Preview env    → staging    (TEST API keys)
#   Vercel Production env → production (LIVE API keys)
# ══════════════════════════════════════════════════════════════════════════════

# ── App ────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development          # development | staging | production

# ── Supabase (free tier: 500 MB DB, 5 GB bandwidth) ───────────────────────────
# Get from: https://supabase.com → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key   # server-only, never expose

# ── AI / LLM (free tier swap: Groq replaces paid Claude calls) ────────────────
# PRIMARY: Groq — FREE (14,400 req/day, llama-3.3-70b-versatile)
#   Sign up at https://console.groq.com → API Keys
GROQ_API_KEY=gsk_your_groq_api_key

# FALLBACK: Anthropic — used only if GROQ_API_KEY is unset
#   (Useful in dev if you already have an Anthropic key configured)
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key

# ── Email notifications (free tier swap: Resend replaces per-SMS Twilio cost) ──
# FREE: 3,000 emails/month, 100/day
# Sign up at https://resend.com → API Keys
# For dev, use the sandbox: RESEND_FROM_EMAIL=onboarding@resend.dev (no domain needed)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=BeeLuxe Cleaners <dispatch@beeluxecleaners.com>

# ── SMS notifications (optional — Twilio $0.0075/msg, use as fallback only) ───
# Leave blank in dev to use demo mode (logs to console, no charge)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# ── Web Push notifications (100% free, native browser API) ────────────────────
# Generate VAPID keys ONCE:
#   node -e "const wp=require('web-push'); const k=wp.generateVAPIDKeys(); console.log(JSON.stringify(k,null,2))"
# Then paste below. The public key is safe to expose; keep private key secret.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:dispatch@beeluxecleaners.com

# ── Cron secrets (protect GET endpoints from public access) ───────────────────
NOTIFY_SECRET=change-me-random-32-chars
ARCHIVE_SECRET=change-me-random-32-chars

# ── Sentry error monitoring ────────────────────────────────────────────────────
# Sign up at https://sentry.io → Project → Settings → DSN
# Leave blank in dev — errors log to console only
SENTRY_DSN=https://xxxx@oxxxx.ingest.sentry.io/xxxx
NEXT_PUBLIC_SENTRY_DSN=https://xxxx@oxxxx.ingest.sentry.io/xxxx
SENTRY_AUTH_TOKEN=sntrys_your_auth_token    # for source map uploads in CI
